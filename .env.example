# Copy to .env and fill in the source-network endpoints.
# Comma-separated lists. Server-side only (never shipped to the client bundle).

# Entry hosts serving the site directly (200, CORS-open).
SCORELINE_ENTRY_HOSTS=
# Old-generation entry hosts that 301 to the current one (walked server-side).
SCORELINE_REDIRECTING_ENTRY_HOSTS=
# Data hosts serving the protobuf feed and the params API.
SCORELINE_API_HOSTS=
# Player hosts serving the bare player page.
SCORELINE_PLAYER_HOSTS=
# Tim-streams second source (docs/tim-extra-streams.md): API origins, tried in order.
SCORELINE_TIM_API_HOSTS=

# Convex (accounts + match alerts, see docs/match-alerts.md).
# `npx convex dev` writes this to .env.local for you; on Vercel set it by hand.
VITE_CONVEX_URL=
# The Convex deployment's own env (set with `npx convex env set`, never here):
# JWT_PRIVATE_KEY, JWKS, SITE_URL, BREVO_API_KEY, MAIL_FROM, APP_ORIGIN,
# SCORELINE_ENTRY_HOSTS, SCORELINE_API_HOSTS, OPERATOR_EMAIL, UNSUBSCRIBE_SECRET.
# Dev deployments only: MAIL_DRY_RUN=1 prints mails to the Convex logs instead of sending.
